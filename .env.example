# OneWayTaxiBihar Production Environment Configuration Template
# OneWayTaxiBihar Mobility Pvt Ltd (onewaytaxibihar.com)
# Copy to .env for production deployment. NEVER commit actual secrets to Git.

# -------------------------------------------------------------
# 1. SERVER & RUNTIME
# -------------------------------------------------------------
PORT=8080
NODE_ENV=production

# -------------------------------------------------------------
# 2. ENTERPRISE CLOUD DATABASE (Choose MongoDB Atlas OR PostgreSQL)
# -------------------------------------------------------------
# Option A: MongoDB Atlas Cloud
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/onewaytaxibihar?retryWrites=true&w=majority
MONGODB_DB_NAME=onewaytaxibihar

# Option B: PostgreSQL / Supabase / Neon (ACID Relational)
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# -------------------------------------------------------------
# 3. PAYMENT GATEWAY (Razorpay & Cashfree India)
# -------------------------------------------------------------
# Razorpay (Live or Test Keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Cashfree PG (Alternative Indian Gateway)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production

# -------------------------------------------------------------
# 4. TELECOM SMS & OTP GATEWAYS (Fast2SMS / MSG91 / Twilio)
# -------------------------------------------------------------
# Fast2SMS (Indian Instant Quick SMS / OTP: https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# MSG91 (DLT Enterprise Telecom Standard: https://msg91.com)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=OWTAXI
MSG91_OTP_TEMPLATE_ID=
MSG91_FLOW_ID=

# Twilio (Global SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -------------------------------------------------------------
# 5. WHATSAPP BUSINESS CLOUD API
# -------------------------------------------------------------
# Meta for Developers / WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=

# -------------------------------------------------------------
# 6. DISPATCH & 2FA SECURITY
# -------------------------------------------------------------
JWT_SECRET=oneway_secure_jwt_secret_production_2026_bihar
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
ADMIN_AUTHORIZED_PHONE=6206494214

